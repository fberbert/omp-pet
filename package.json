{
  "name": "omp-pet",
  "version": "0.1.0",
  "description": "A Linux desktop pet that reacts to your OMP (oh-my-pi) coding agent sessions in real time.",
  "main": "src/main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --linux",
    "build:linux:x64": "electron-builder --linux AppImage:x64 deb:x64",
    "verify:electron": "node scripts/verify-electron-install.js",
    "postinstall": "node scripts/verify-electron-install.js --context postinstall",
    "test": "node test/run-tests.js",
    "audit:assets": "node scripts/audit-repository-assets.js",
    "audit:pr-history-assets": "node scripts/audit-pr-history-assets.js",
    "audit:native-package": "node scripts/audit-packaged-native.js",
    "create-theme": "node scripts/create-theme.js",
    "install:omp-extension": "node hooks/omp-install.js",
    "uninstall:omp-extension": "node hooks/omp-install.js --uninstall"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "desktop-pet",
    "electron",
    "linux"
  ],
  "author": "Fábio Berbert de Paula <fberbert@gmail.com>",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "build": {
    "appId": "com.fberbert.omp-pet",
    "productName": "OMP Pet",
    "afterPack": "scripts/after-pack-koffi.js",
    "linux": {
      "maintainer": "Fábio Berbert de Paula <fberbert@gmail.com>",
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "OMP-Pet-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "omp-pet"
    },
    "files": [
      "NOTICE.md",
      "src/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "assets/icons/agents/**/*",
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "assets/sounds/**/*",
      "assets/tray-icon*.png",
      "hooks/**/*",
      "agents/**/*",
      "themes/**/*"
    ],
    "asarUnpack": [
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "hooks/**/*",
      "agents/**/*",
      "themes/**/*"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.7",
    "js-yaml": "^4.1.0"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "koffi": "2.16.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fberbert/omp-pet.git"
  }
}
